{
  "name": "@captia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 'dist/test/**/*.test.js'",
    "openapi": "tsc -p tsconfig.json && node dist/src/scripts/write-openapi.js",
    "bootstrap-admin": "node dist/src/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@captia/validation": "workspace:*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "typescript": "6.0.3"
  }
}
