# CAPTIA OS — variables de entorno (copia a .env y rellena; .env nunca se sube al repositorio).
# Ningún secreto va en el código. Las claves con "SERVICE_ROLE" o "SECRET" solo viven en servidores.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Conexión directa a Postgres de Supabase (Settings → Database → Connection string, rol postgres).
# Con el pooler en modo transacción (puerto 6543) también funciona: cada petición es una transacción.
DATABASE_URL=postgresql://postgres:CAMBIAR@db.TU-PROYECTO.supabase.co:5432/postgres
DATABASE_SSL=require            # disable | require | verify-full
DATABASE_POOL_MAX=10
# URL del proyecto Supabase (emisor de los JWT). La API verifica los tokens con sus claves públicas (JWKS).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Opcional: solo si el proyecto sigue firmando con el secreto HS256 heredado.
SUPABASE_JWT_SECRET=
# Opcional: habilita las invitaciones por correo. Sin ella, la API responde "pendiente de configuración".
SUPABASE_SERVICE_ROLE_KEY=
# Orígenes del panel web permitidos por CORS (separados por comas).
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Panel web (apps/web) — todas se leen en el servidor de Next.js, ninguna llega al navegador.
# ---------------------------------------------------------------------------
CAPTIA_API_URL=http://127.0.0.1:4000
# SUPABASE_URL (arriba) y la clave publicable (o "anon" en proyectos antiguos):
SUPABASE_PUBLISHABLE_KEY=
